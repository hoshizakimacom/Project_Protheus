STATIC FUNCTION NOVOITEMEMAIL(CTABELADEPRECO,CITEM,CPRODUTO,CANTIGOPRECOVENDA,CNOVOPRECODEVENDA,CLOGMENSAGEM,CMAILMENSAGEM,DDATAVIGENCIA)
LOCAL CTIPOPRODUTO
LOCAL CDESCRICAOPRODUTO

CTIPOPRODUTO := POSICIONE("SB1",1,XFILIAL("SB1")+PADR(CPRODUTO,TAMSX3("B1_COD")[1]),"B1_TIPO")
CDESCRICAOPRODUTO := POSICIONE("SB1",1,XFILIAL("SB1")+PADR(CPRODUTO,TAMSX3("B1_COD")[1]),"B1_DESC")

CMAILMENSAGEM += "<TR>"

CMAILMENSAGEM += '<TD  WIDTH=80 ALIGN="MIDDLE" STYLE="BORDER-TOP:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-LEFT:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-BOTTOM:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-RIGHT:SOLID #DEDEDE 1.0PT">'
CMAILMENSAGEM += CTABELADEPRECO
CMAILMENSAGEM += "</TD>"

CMAILMENSAGEM += '<TD  WIDTH=80 ALIGN="MIDDLE" STYLE="BORDER-TOP:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-LEFT:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-BOTTOM:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-RIGHT:SOLID #DEDEDE 1.0PT">'
CMAILMENSAGEM += CITEM
CMAILMENSAGEM += "</TD>"

CMAILMENSAGEM += '<TD  WIDTH=150 STYLE="BORDER-TOP:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-LEFT:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-BOTTOM:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-RIGHT:SOLID #DEDEDE 1.0PT">'
CMAILMENSAGEM += CPRODUTO
CMAILMENSAGEM += "</TD>"

CMAILMENSAGEM += '<TD  WIDTH=100 ALIGN="MIDDLE" STYLE="BORDER-TOP:SOLID #DEDEDE 1.0PT
CMAILMENSAGEM += 'BORDER-LEFT:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-BOTTOM:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-RIGHT:SOLID #DEDEDE 1.0PT">'
CMAILMENSAGEM += CTIPOPRODUTO
CMAILMENSAGEM += "</TD>"

CMAILMENSAGEM += '<TD  WIDTH=300 STYLE="BORDER-TOP:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-LEFT:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-BOTTOM:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-RIGHT:SOLID #DEDEDE 1.0PT">'
CMAILMENSAGEM += CDESCRICAOPRODUTO
CMAILMENSAGEM += "</TD>"

CMAILMENSAGEM += '<TD  WIDTH=125 ALIGN="RIGHT" STYLE="BORDER-TOP:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-LEFT:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-BOTTOM:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-RIGHT:SOLID #DEDEDE 1.0PT">'
CMAILMENSAGEM += CANTIGOPRECOVENDA
CMAILMENSAGEM += "</TD>"

CMAILMENSAGEM += '<TD  WIDTH=125 ALIGN="RIGHT" STYLE="BORDER-TOP:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-LEFT:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-BOTTOM:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-RIGHT:SOLID #DEDEDE 1.0PT">'
CMAILMENSAGEM += CNOVOPRECODEVENDA
CMAILMENSAGEM += "</TD>"

CMAILMENSAGEM += '<TD  WIDTH=125 ALIGN="RIGHT" STYLE="BORDER-TOP:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-LEFT:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-BOTTOM:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-RIGHT:SOLID #DEDEDE 1.0PT">'
CMAILMENSAGEM += DTOC(DDATAVIGENCIA)
CMAILMENSAGEM += "</TD>"

CMAILMENSAGEM += '<TD  WIDTH=250 STYLE="BORDER-TOP:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-LEFT:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-BOTTOM:SOLID #DEDEDE 1.0PT;'
CMAILMENSAGEM += 'BORDER-RIGHT:SOLID #DEDEDE 1.0PT">'
CMAILMENSAGEM += CLOGMENSAGEM
CMAILMENSAGEM += "</TD>"

CMAILMENSAGEM += "</TR>" + CRLF

RETURN 

/////////////////////////////////////////////////////////////
// FONTE RECONSTRUIDO PELO TIME BSO ********************** //
/////////////////////////////////////////////////////////////
STATIC FUNCTION ENVIAEMAIL(CMAILMENSAGEM,CERROR,CHTMLLOG)
LOCAL LDISCONNECT
LOCAL CDATAPROCESSAMENTO
LOCAL CHORAPROCESSAMENTO
LOCAL CSERVER
LOCAL CACCOUNT
LOCAL CPASSWORD
LOCAL LAUTH
LOCAL OPROCESS
LOCAL OHTML
LOCAL CBODY
LOCAL CPARA
LOCAL CUSUARIO
LOCAL CPROCESSO
LOCAL CASSUNTO
LOCAL LCONNECTED
LOCAL LRETURN

LDISCONNECT :=  .T. 
CDATAPROCESSAMENTO := DTOC(DATE())
CHORAPROCESSAMENTO := TIME()
CSERVER :=  ALLTRIM(GETMV("MV_RELSERV",,""))
CACCOUNT :=  ALLTRIM(GETMV("MV_RELACNT",,""))
CPASSWORD :=  ALLTRIM(GETMV("MV_RELPSW",,""))
LAUTH := GETMV("MV_RELAUTH",,"")
CBODY := ""
CPARA :=  ALLTRIM(GETMV("AM_05D0101",,""))
CUSUARIO :=  UPPER(USRRETNAME(RETCODUSR()))
CPROCESSO := "M05D01"
CASSUNTO := "ATUALIZAÇÃO DE TABELA DE PREÇO"
LCONNECTED :=  .F. 

LRETURN :=  .F. 
 
    IF EMPTY(CPARA)
        BREAK 
    ENDIF
    
    OPROCESS := TWFPROCESS():NEW("",CPROCESSO)
    OPROCESS:NEWTASK("INICIO","/WORKFLOW/MACOM/WF_MACOM_GENERICO.HTML")
    
    OHTML := OPROCESS:OHTML
    OHTML:VALBYNAME("PROCESSO",CPROCESSO+" - "+CASSUNTO)
    OHTML:VALBYNAME("USUARIO",CUSUARIO)
    OHTML:VALBYNAME("DATA",CDATAPROCESSAMENTO)
    OHTML:VALBYNAME("HORA",CHORAPROCESSAMENTO)
    OHTML:VALBYNAME("MSG",CMAILMENSAGEM)
    
    CBODY := OHTML:HTMLCODE()
    
    CHTMLLOG := CBODY
    
    IF ( .F. ) 
    LCONNECTED := CALLPROC("MAILSMTPON",CSERVER,CACCOUNT,CPASSWORD,,,)
    ELSE
    LCONNECTED := MAILSMTPON(CSERVER,CACCOUNT,CPASSWORD,,,)
    ENDIF
    
    IF LAUTH
        
        IF !(MAILAUTH(CACCOUNT,CPASSWORD))
            CERROR := "ERRO AO CONECTAR NA CONTA DE E-MAIL."
            
            IF ( .F. ) 
            CALLPROC("MAILSMTPOFF")
            ELSE
            MAILSMTPOFF()
            ENDIF
            
            BREAK 
        ENDIF
    ENDIF
    
    IF !(MAILSEND(CACCOUNT,{CPARA},{},{},"WORKFLOW MACOM - "+CASSUNTO,CBODY,{""}, .T. ))
        
        IF ( .F. ) 
        CERROR := CALLPROC("MAILGETERR")
        ELSE
        CERROR := MAILGETERR()
        ENDIF
        BREAK 
    ENDIF
    
    IF ( .F. ) 
    LDISCONNECT := CALLPROC("MAILSMTPOFF")
    ELSE
    LDISCONNECT := MAILSMTPOFF()
    ENDIF
    
    OPROCESS:FREE()
    OPROCESS := NIL
    
    LRETURN :=  .T. 

RETURN LRETURN

/////////////////////////////////////////////////////////////
// FONTE RECONSTRUIDO PELO TIME BSO ********************** //
/////////////////////////////////////////////////////////////
STATIC FUNCTION GRAVALOGLOCAL(CHTMLLOG,CNOMEARQUIVO)
LOCAL CCAMINHOLOG
LOCAL CARQUIVOHTML

CCAMINHOLOG := GETTEMPPATH()
CARQUIVOHTML := CNOMEARQUIVO+".HTML"

IF SUBSTRING(CCAMINHOLOG, LEN(CCAMINHOLOG),1)<>"\"
    CCAMINHOLOG += "\"
ENDIF

MEMOWRITE(CCAMINHOLOG+CARQUIVOHTML,CHTMLLOG)
SHELLEXECUTE("OPEN",CARQUIVOHTML,"",CCAMINHOLOG,1)

RETURN 
