User Function MA261D3

Local aArea := GetArea()
Local cOp := Acols[n,aScan( aHeader, { |x| AllTrim( x[2] ) == "D3_XOP"})]

If !Empty(cOp)
	RecLock("SD3",.F.)
	SD3->D3_XOP := cOp
	MsUnLock()
EndIf

RestArea(aArea)

Return
