oTempTable:AddIndex("1", {"FT_CFOP", "X5DESCRI","FT_CODBCC","FT_CSTPIS","FT_CSTCOF","FT_ALIQPIS","FT_ALIQCOF","A1_XORGPUB","LINHA","CFOP","DESCR.CFO","CST","ALIQ"} )


 
