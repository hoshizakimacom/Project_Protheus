STATIC FUNCTION X3XTIT(CCAMPO)

LOCAL AAREA := GETAREA()
LOCAL CRETORNO := ""

DBSELECTAREA("SX3")
DBSETORDER(2)
IF DBSEEK(CCAMPO, .F. )

    CRETORNO := GetSX3Cache(CCAMPO, "X3_TITULO")
ENDIF

RESTAREA(AAREA)
RETURN CRETORNO

